{
  "description": "Test cases for deterministic intent classification and entity extraction",
  "version": "1.0",
  "cases": [
    {
      "id": "intent_01_book_full",
      "user_input": "Book an endocrinologist at AIIMS Delhi for 2026-08-29 at 10:00. Patient: John Doe, john@example.com",
      "expected_action": "book",
      "expected_entities": {
        "specialty": "Endocrinologist",
        "city": "Delhi",
        "date": "2026-08-29",
        "time": "10:00",
        "patient_email": "john@example.com",
        "appointment_id": null
      },
      "expected_missing": [],
      "expected_actionable": true,
      "category": "book"
    },
    {
      "id": "intent_02_book_tomorrow",
