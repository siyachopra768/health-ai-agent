        "specialty": "Hematologist",
        "city": "Gurgaon",
        "date": null,
        "time": "14:30",
        "patient_email": "jane@test.com",
        "appointment_id": null
      },
      "expected_missing": ["date"],
      "expected_actionable": true,
      "category": "book"
